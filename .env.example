# =============================================================================
# WRNC Environment Configuration
# =============================================================================
#
# Copy this file to:
#
#   .env
#
# Then replace the placeholder values below with your own credentials.
#
# Never commit your .env file to source control.
#
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase
# -----------------------------------------------------------------------------

EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------

EXPO_PUBLIC_APP_ENV=development

EXPO_PUBLIC_APP_NAME=WRNC

EXPO_PUBLIC_COMPANY_NAME=Swear Like A Sailor, LLC

# -----------------------------------------------------------------------------
# Feature Flags (Optional)
# -----------------------------------------------------------------------------

EXPO_PUBLIC_ENABLE_DEBUG_LOGGING=true

EXPO_PUBLIC_ENABLE_ANALYTICS=false

# MOTOR sandbox test surface. These values are safe for the client bundle.
# Keep disabled unless an internal test proxy is configured.
EXPO_PUBLIC_ENABLE_MOTOR_SANDBOX=false
EXPO_PUBLIC_MOTOR_PROXY_URL=

# Server-only MOTOR proxy settings. Never prefix secrets with EXPO_PUBLIC_.
MOTOR_SANDBOX_ENABLED=false
MOTOR_SANDBOX_MODE=mock
MOTOR_ALLOWED_ORIGIN=
MOTOR_SANDBOX_BASE_URL=https://api.motor.com
MOTOR_SANDBOX_VIN_PATH=/v1/Information/Vehicles/Search/ByVIN
MOTOR_SANDBOX_PUBLIC_KEY=
MOTOR_SANDBOX_PRIVATE_KEY=
