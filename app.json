{
  "expo": {
    "name": "WRNC",
    "slug": "garageosofficial",
    "owner": "wrnc",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/brand/platform/wrnc-app-icon-ios-1024.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#080808"
    },
    "updates": {
      "fallbackToCacheTimeout": 0
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.wrnc.app",
      "buildNumber": "14",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand/platform/wrnc-adaptive-icon-foreground.png",
        "backgroundColor": "#000000"
      },
      "package": "com.wrnc.mobile",
      "versionCode": 1,
      "permissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.INTERNET"
      ]
    },
    "web": {
      "favicon": "./assets/brand/platform/wrnc-platform-favicon.png"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow WRNC to access your photos and videos for vehicle documentation.",
          "cameraPermission": "Allow WRNC to access your camera to document your builds.",
          "microphonePermission": false
        }
      ],
      "expo-file-system",
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "c7cfc85b-904f-4d2a-8fbb-1aec8f51aecb"
      }
    },
    "scheme": "wrnc",
    "platforms": [
      "ios",
      "android",
      "web"
    ]
  }
}
