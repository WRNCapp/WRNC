{
  "name": "wrnc",
  "version": "0.1.0",
  "description": "WRNC - Vehicle Build Documentation & Collaboration Platform",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "jest",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx --ignore-pattern 'dist/**' --ignore-pattern '.expo/**' --ignore-pattern '.npm-cache/**'",
    "type-check": "tsc --noEmit",
    "build": "npm run build:web",
    "build:android": "eas build --platform android",
    "build:ios": "eas build --platform ios",
    "build:web": "expo export --platform web",
    "qa:attachments:live": "node scripts/live-attachment-qa.mjs",
    "qa:motor:live": "node scripts/motor-sandbox-evidence.mjs"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "~1.23.1",
    "@react-navigation/bottom-tabs": "^6.5.20",
    "@react-navigation/native": "^6.1.9",
    "@supabase/supabase-js": "^2.43.1",
    "@tanstack/react-query": "^5.35.1",
    "axios": "^1.6.5",
    "expo": "^50.0.0",
    "expo-document-picker": "~11.10.1",
    "expo-file-system": "~16.0.6",
    "expo-image-picker": "~14.7.1",
    "expo-router": "^3.4.0",
    "expo-status-bar": "~1.11.1",
    "nativewind": "^2.0.11",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-native": "0.73.6",
    "react-native-gesture-handler": "~2.14.1",
    "react-native-reanimated": "~3.6.0",
    "react-native-safe-area-context": "4.8.2",
    "react-native-screens": "~3.27.0",
    "react-native-svg": "14.1.0",
    "react-native-url-polyfill": "^2.0.0",
    "react-native-web": "~0.19.6",
    "tailwindcss": "3.3.0",
    "zustand": "^4.4.7"
  },
  "devDependencies": {
    "@types/react": "~18.2.37",
    "@types/react-native": "^0.73.0",
    "@types/jest": "^29.5.10",
    "typescript": "^5.3.3",
    "jest": "^29.7.0",
    "jest-expo": "^50.0.1",
    "eslint": "^8.54.0",
    "eslint-config-expo": "^7.0.0",
    "prettier": "^3.1.0",
    "babel-preset-expo": "^10.0.1",
    "@testing-library/react-native": "^12.4.5",
    "react-test-renderer": "18.2.0"
  },
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "jest": {
    "preset": "jest-expo",
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@unimodules/.*|unimodules|sentry-expo|native-base|react-native-svg|@supabase/.*)/)"
    ],
    "setupFiles": [
      "./jest.setup.js"
    ],
    "collectCoverageFrom": [
      "services/**/*.{ts,tsx}",
      "hooks/**/*.{ts,tsx}",
      "utils/**/*.{ts,tsx}",
      "components/**/*.{ts,tsx}"
    ]
  }
}
