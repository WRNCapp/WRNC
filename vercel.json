{
  "routes": [
    {
      "src": "/",
      "dest": "/api/coming-soon"
    },
    {
      "src": "/coming-soon",
      "dest": "/api/coming-soon"
    },
    {
      "src": "/.well-known/apple-app-site-association",
      "headers": { "Content-Type": "application/json" },
      "continue": true
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
